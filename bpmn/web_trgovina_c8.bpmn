<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_WebTrgovina" targetNamespace="http://example.com/web-trgovina" exporter="Camunda Modeler" exporterVersion="5.52.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="ObradaNarudzbe" name="Obrada narudžbe u web-trgovini" isExecutable="true">
    <bpmn:startEvent id="Start_Narudzba" name="Kupac poslao narudžbu">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ZaprimiNarudzbu" name="Zaprimi narudžbu">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProvjeriZalihe" name="Provjeri zalihe">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_NaZalihi" name="Roba na zalihi?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_ZaliheDa</bpmn:outgoing>
      <bpmn:outgoing>Flow_ZaliheNe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NaruciOdDobavljaca" name="Naruči robu od dobavljača">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ZaliheNe</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Dobavljac" name="Dobavljač može isporučiti?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_DobavljacDa</bpmn:outgoing>
      <bpmn:outgoing>Flow_DobavljacNe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_OtkaziNarudzbu" name="Otkaži narudžbu">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DobavljacNe</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Otkazano" name="Narudžba otkazana">
      <bpmn:incoming>Flow_05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ZaprimiRobu" name="Zaprimi robu od dobavljača">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DobavljacDa</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_SpojiZalihe">
      <bpmn:incoming>Flow_ZaliheDa</bpmn:incoming>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="AND_Razdvoji">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_ParNaplata</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParPakiranje</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParRacun</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_PetljaNaplate">
      <bpmn:incoming>Flow_ParNaplata</bpmn:incoming>
      <bpmn:incoming>Flow_PonoviNaplatu</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Naplati" name="Naplati narudžbu">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Placanje" name="Plaćanje uspješno?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_PlacanjeDa</bpmn:outgoing>
      <bpmn:outgoing>Flow_PlacanjeNe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ObavijestiNeuspjeh" name="Obavijesti kupca o neuspjelom plaćanju">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PlacanjeNe</bpmn:incoming>
      <bpmn:outgoing>Flow_PonoviNaplatu</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Zapakiraj" name="Zapakiraj robu">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParPakiranje</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_IzdajRacun" name="Izdaj račun">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParRacun</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="AND_Spoji">
      <bpmn:incoming>Flow_PlacanjeDa</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_NacinDostave" name="Način dostave?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_Kurir</bpmn:outgoing>
      <bpmn:outgoing>Flow_Osobno</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PosaljiKurirom" name="Pošalji kurirskom službom">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Kurir</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PripremiPreuzimanje" name="Pripremi za osobno preuzimanje">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Osobno</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_SpojiDostavu">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ZatvoriNarudzbu" name="Zatvori narudžbu">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="web-trgovina" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Zavrseno" name="Narudžba završena">
      <bpmn:incoming>Flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start_Narudzba" targetRef="Task_ZaprimiNarudzbu" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ZaprimiNarudzbu" targetRef="Task_ProvjeriZalihe" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ProvjeriZalihe" targetRef="GW_NaZalihi" />
    <bpmn:sequenceFlow id="Flow_ZaliheDa" name="da" sourceRef="GW_NaZalihi" targetRef="GW_SpojiZalihe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=naZalihi = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ZaliheNe" name="ne" sourceRef="GW_NaZalihi" targetRef="Task_NaruciOdDobavljaca">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=naZalihi = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_NaruciOdDobavljaca" targetRef="GW_Dobavljac" />
    <bpmn:sequenceFlow id="Flow_DobavljacDa" name="da" sourceRef="GW_Dobavljac" targetRef="Task_ZaprimiRobu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=dobavljacDostupan = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DobavljacNe" name="ne" sourceRef="GW_Dobavljac" targetRef="Task_OtkaziNarudzbu">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=dobavljacDostupan = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Task_OtkaziNarudzbu" targetRef="End_Otkazano" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_ZaprimiRobu" targetRef="GW_SpojiZalihe" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="GW_SpojiZalihe" targetRef="AND_Razdvoji" />
    <bpmn:sequenceFlow id="Flow_ParNaplata" sourceRef="AND_Razdvoji" targetRef="GW_PetljaNaplate" />
    <bpmn:sequenceFlow id="Flow_ParPakiranje" sourceRef="AND_Razdvoji" targetRef="Task_Zapakiraj" />
    <bpmn:sequenceFlow id="Flow_ParRacun" sourceRef="AND_Razdvoji" targetRef="Task_IzdajRacun" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="GW_PetljaNaplate" targetRef="Task_Naplati" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_Naplati" targetRef="GW_Placanje" />
    <bpmn:sequenceFlow id="Flow_PlacanjeDa" name="da" sourceRef="GW_Placanje" targetRef="AND_Spoji">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=placanjeUspjesno = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PlacanjeNe" name="ne" sourceRef="GW_Placanje" targetRef="Task_ObavijestiNeuspjeh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=placanjeUspjesno = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PonoviNaplatu" sourceRef="Task_ObavijestiNeuspjeh" targetRef="GW_PetljaNaplate" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Zapakiraj" targetRef="AND_Spoji" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_IzdajRacun" targetRef="AND_Spoji" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="AND_Spoji" targetRef="GW_NacinDostave" />
    <bpmn:sequenceFlow id="Flow_Kurir" name="kurir" sourceRef="GW_NacinDostave" targetRef="Task_PosaljiKurirom">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nacinDostave = "kurir"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Osobno" name="osobno" sourceRef="GW_NacinDostave" targetRef="Task_PripremiPreuzimanje">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=nacinDostave = "osobno"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_PosaljiKurirom" targetRef="GW_SpojiDostavu" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_PripremiPreuzimanje" targetRef="GW_SpojiDostavu" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="GW_SpojiDostavu" targetRef="Task_ZatvoriNarudzbu" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_ZatvoriNarudzbu" targetRef="End_Zavrseno" />
  </bpmn:process>
